# TEMPLATE ONLY. Merge the needed values into .env; do not overwrite it.
# Both sidecars default to the Host interpreter, so the local-rocm profile keeps
# Host, ASR, and TTS packages in the same project .venv.
ASR_BACKEND=qwen3_asr
ASR_LANGUAGE=zh
QWEN3_ASR_MODE=sidecar
QWEN3_ASR_MODEL_PATH=assets/models/asr/qwen3-asr-0.6b
QWEN3_ASR_DEVICE=cuda
QWEN3_ASR_REQUIRE_CUDA=true
QWEN3_ASR_WARMUP=1

TTS_BACKEND=gpt_sovits
TTS_MODE=sidecar
TTS_DEVICE=cuda:0
TTS_REQUIRE_CUDA=1
# Replace both filenames with compatible, legally obtained GPT-SoVITS v3 files.
TTS_GPT_MODEL_PATH=assets/models/gpt-sovits/weights/gpt/v3/YOUR_GPT.ckpt
TTS_SOVITS_MODEL_PATH=assets/models/gpt-sovits/weights/sovits/v3/YOUR_SOVITS.pth
TTS_OUTPUT_LANGUAGE=日文
TTS_REF_AUDIO_JA=assets/audio/reference/YOUR_REFERENCE.wav
TTS_REF_TEXT_JA=ここに参照音声と一致する文章を入力してください。
NLTK_DATA=./assets/nltk_data

# Conservative first-run baseline. Enable Graph only after passing validation.
ENABLE_CUDA_GRAPH=0
ENABLE_CUDA_GRAPH_PRECAPTURE=0
TTS_T2S_FLASH_ATTN=0
BIGVGAN_USE_CUDA_KERNEL=0
TTS_STARTUP_INFERENCE_WARMUP=0

# Start with text input. Enable continuous wake only after ASR and TTS pass.
WAKE_ENABLED=false
WAKE_ASR_BACKEND=qwen3_asr
WAKE_PHRASES=克里斯汀娜
