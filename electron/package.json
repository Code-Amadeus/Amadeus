{
  "name": "amadeus-desktop",
  "version": "0.1.0",
  "description": "Amadeus AI Companion — Electron frontend",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "test": "node --experimental-strip-types --test tests/providerEventVisibility.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "win": {
      "icon": "../assets/icons/app/app_icon.ico"
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "wait-on": "^8.0.0"
  }
}
