# =============================================================================
# .env.example — 配置模板，复制为 .env 并填入真实值
# 密钥默认留空，可在 Electron Settings 中保存；带默认值的可按需修改
# =============================================================================

# ── LLM routing : remote Main Chat baseline ────────────────────────────────────
# Select a packaged character id. Changing it or its TOML requires a backend restart.
# Process environment values override this file. See config/README.md.
# Main chat provider: deepseek | openai | gemini | bedrock | local | hybrid | hybrid2 | hybrid3
# DeepSeek is the first-release Main Chat profile. Other providers remain explicit opt-ins.

# Log the exact subscriber responsible for user-visible event backpressure.
EVENT_BUS_SLOW_CALLBACK_S=1.0

# ── LLM : Gemini ─────────────────────────────────────────────────────────────

# OpenAI-compatible provider

# ── LLM : AWS Bedrock ────────────────────────────────────────────────────────
AWS_BEDROCK_USE_CACHE=true
AWS_BEDROCK_CACHE_TTL=3600
AWS_BEDROCK_CONNECTION_POOL_SIZE=10
AWS_BEDROCK_MAX_KEEPALIVE=5
AWS_BEDROCK_KEEPALIVE_EXPIRY=60.0

# ── 本地 LLM ─────────────────────────────────────────────────────────────────
# Optional pure-local profile; llama.cpp is its default backend. LLM_PROVIDER is the only chat router.

# Hybrid local head: always an OpenAI-compatible endpoint, independent of LOCAL_LLM_TYPE.

# 仅控制下一轮模型可见的 assistant 历史；GUI/TTS 始终不显示 EMO 标签。
# strip | expressive_only | preserve
EMO_HISTORY_POLICY=strip

# Required by the BAT launchers, managed llama-server, or llama-cli compatibility mode.

# llama-server 启动参数（各字段单独配置）
# Unset: managed pure-local uses 16384; Hybrid head uses 4096.
# An explicit value overrides both profiles. Larger contexts use more memory.

# ── Optional character RAG (all Main Chat models; restart required) ─────────────
# Build first: see docs/character_rag.md. No runtime downloads.
# Retrieved excerpts are sent to the selected chat model, including remote APIs.

# ── VTS ──────────────────────────────────────────────────────────────────────

# ── Speech synthesis ────────────────────────────────────────────────────────
# BEGIN GENERATED CONFIG: speech_synthesis
# Speech synthesis
TTS_BACKEND=gpt_sovits
# END GENERATED CONFIG: speech_synthesis
# Remote OpenAI-compatible POST /audio/speech (used only by the remote backend)
# BEGIN GENERATED CONFIG: tts_remote
# Remote speech API
# TTS_API_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=<your-api-key>
# TTS_API_MODEL=gpt-4o-mini-tts
# TTS_API_VOICE=alloy
# TTS_API_STREAM_PROTOCOL=openai_sse  # buffered | openai_sse
# END GENERATED CONFIG: tts_remote
# MiMo TTS（小米，chat-completions 音频协议，流式 PCM16 仅 mimo-v2.5-tts 支持）
# BEGIN GENERATED CONFIG: tts_mimo
# MiMo speech API (Xiaomi)
# MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_TTS_API_KEY=<your-api-key>
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICE=冰糖
# END GENERATED CONFIG: tts_mimo
# BEGIN GENERATED CONFIG: tts_fish_audio
# Fish Audio speech API
# FISH_TTS_WS_URL=wss://api.fish.audio/v1/tts/live
# FISH_TTS_API_KEY=<your-api-key>
# FISH_TTS_MODEL=s2.1-pro-free
# FISH_TTS_REFERENCE_ID=b450b19370434173b121446057622e9b
# FISH_TTS_LATENCY=balanced  # normal | balanced | low
# END GENERATED CONFIG: tts_fish_audio
# TTS_API_TIMEOUT_SECONDS=60        # shared remote TTS network timeout
# Embedded model paths (relative to the repository or absolute)
# BEGIN GENERATED CONFIG: tts_embedded_v3
# Embedded GPT-SoVITS model
TTS_VOICE_PROFILE=kurisu_v3  # kurisu_v3 | kurisu_v2pro | custom
TTS_DEVICE=auto
TTS_GPT_MODEL_PATH=
TTS_SOVITS_MODEL_PATH=
# END GENERATED CONFIG: tts_embedded_v3
# CPU synthesis automatically uses a sidecar; CUDA/MPS stay embedded by default.
# TTS_MODE=sidecar                  # explicitly isolate CUDA/MPS too
# TTS_PYTHON=C:\path\to\python.exe  # optional; blank uses the current .venv
# TTS_REQUIRE_CUDA=1                # PyTorch HIP also uses the torch.cuda API
# The embedded backend supports GPT-SoVITS v1/v2/v2Pro/v2ProPlus/v3 checkpoints.
# Named profiles select a compatible GPT/SoVITS pair atomically. Use custom to
# supply the two paths below yourself.

# Optional Windows CUDA V3 Japanese semantic references. Install the emotion
# pack first; restart after changing. Enabled startup prewarms all references.

# ── TTS 管线调优 ──────────────────────────────────────────────────────────────
SEGMENT_CHAR_LIMIT=140
USE_EXPERIMENTAL_TTS_STREAM=true
# 1 = standard single synthesis (default); 2 = the desktop Parallel ×2 mode.
# Experimental sentence-bounded grouping; disabled by default.
# ENABLE_TTS_UTTERANCE_SCHEDULER=1
# TTS_UTTERANCE_MIN_START_SEQ=2
# TTS_UTTERANCE_MAX_CHARS=120
# TTS_UTTERANCE_FLUSH_TIMEOUT_MS=350  # 0 disables grouping
# TTS_UTTERANCE_MAX_SENTENCES=2      # strict fragment cap; absent/blank enables adaptive grouping
USE_FIRST_SENTENCE_SPRINT=false
DISPLAY_FALLBACK_WINDOW_SEC=1.5
# TTS 诊断总开关：true 时打开 tts 相关 DEBUG + v3 流式每块 CFM/BigVGAN 毫秒（略增开销）
TTS_DIAG_VERBOSE=false
# Experimental T2S FlashAttention2 KV-cache path. Keep disabled unless testing.
# TTS_T2S_FLASH_ATTN=0
# TTS_T2S_FLASH_ATTN_MODE=valid
# Diagnostic only: force a full device sync after every T2S CUDA Graph replay.
# CUDA_GRAPH_REPLAY_SYNC=0
# 单独开启流式同步计时（不设 TTS_DIAG_VERBOSE 时也可手动设为 1）
# TTS_STREAM_SYNC_TIMING=0
# 首句更早切分（字符数，strip 后）；0=关闭。默认代码里若未写则见 config/settings.py
# FIRST_SENTENCE_EARLY_CUT_CHARS=16

# ── 麦克风选择 ────────────────────────────────────────────────────────────
# 优先匹配的设备名称关键词（部分匹配，不区分大小写），如 FreeBuds / Headset
# Full conversation recognizer. Wake remains an independent role below.
# Optional override; blank uses assets/models/asr/qwen3-asr-0.6b, then a legacy HF cache.
# QWEN3_ASR_MODE=sidecar
# QWEN3_ASR_PYTHON=C:\path\to\python.exe  # optional; blank uses the current .venv
# QWEN3_ASR_WARMUP=1
# Increase this if natural pauses are being cut off.
# Seconds in VRAM after the last conversation activity; then Wake standby takes
# over and an in-process Qwen3-ASR waits in RAM (docs/wake_word_setup.md).
# ASR_IDLE_UNLOAD_SECONDS=180
# Seconds in RAM after listening stops before unloading; 0 keeps it loaded.
# ASR_RAM_UNLOAD_SECONDS=0
# Remote OpenAI-compatible POST /audio/transcriptions
# 直接指定设备索引（-1 = 自动选择）
# MICROPHONE_FALLBACK_DEVICE_INDEX=-1
# MICROPHONE_FALLBACK_NAME=

# Advanced wake tuning. Defaults are shown; leave commented for normal use.
# Higher match/VAD/RMS thresholds are stricter and may reduce false wakes.
# WAKE_MATCH_THRESHOLD=0.10
# WAKE_AUTO_START_WITH_WALLPAPER=true
# WAKE_AWAKE_SECONDS=60
# WAKE_BRIDGE_MAX_SECONDS=45
# WAKE_BRIDGE_AUTO_SEND=false
# WAKE_VAD_THRESHOLD=0.45
# WAKE_MIN_SEGMENT_RMS=0.003
# Personalized wake templates remain local under runtime/.
# WAKE_TEMPLATE_CACHE_ENABLED=true
# WAKE_TEMPLATE_CACHE_DIR=runtime\wake_templates
# WAKE_TEMPLATE_CACHE_THRESHOLD=0.68
# WAKE_TEMPLATE_CACHE_LEARN_THRESHOLD=0.80
# WAKE_TEMPLATE_CACHE_MAX_PER_DEVICE=8
# WAKE_TEMPLATE_CACHE_MIN_MS=500
# WAKE_TEMPLATE_CACHE_MAX_MS=2600
# Energy fallback is disabled unless Silero VAD is unavailable or unsuitable.
# WAKE_ENERGY_FALLBACK=false
# WAKE_ENERGY_START_RMS=0.020
# WAKE_ENERGY_END_RMS=0.010
# Log one wake-input RMS sample per second; no audio file is written.
# WAKE_DEBUG_AUDIO=false

# Electron defaults the first two flags on; direct Python startup defaults off.
# ASR_ECHO_TAIL_GUARD_MS=650

# Optional wallpaper/scenario overrides
# standard: 60 FPS + native DPR; power_saving: 30 FPS + max 1.5 DPR;
# custom: use RENDER_MAX_FPS and RENDER_MAX_RESOLUTION below.
# BEGIN GENERATED CONFIG: graphics_budget
# Rendering budget
GRAPHICS_PROFILE=standard  # standard | power_saving | custom
RENDER_MAX_FPS=30
RENDER_MAX_RESOLUTION=1.5
# END GENERATED CONFIG: graphics_budget
# Sampling defaults on at 60 FPS, off at other rates. Explicit overrides win.
# Upgrading: remove an old explicit false to adopt the new default; it is not auto-migrated.
# BEGIN GENERATED CONFIG: graphics_sampling
# Texture loading
# RENDER_TEXTURE_SAMPLING=false
# RENDER_BC7_CACHE=false
# END GENERATED CONFIG: graphics_sampling
# Rebuildable BC7 disk cache for HTTP wallpaper surfaces (4 GiB target; 1 GiB free-space reserve).
# AMADEUS_WALLPAPER_PATH=C:\path\to\wallpaper.png
# AMADEUS_SCENARIO_ROOT=C:\path\to\scenario-source
# AMADEUS_SCENARIO_BACKPLATE_PATH=C:\path\to\backplate.png
# AMADEUS_SCENARIO_IDLE_SECONDS=60
# AMADEUS_SCENARIO_STATIC_SECONDS=15
# AMADEUS_SCENARIO_FRAME_PLAYBACK=true
AMADEUS_PRE_TRANSLATION_ENABLED=false

# ── OpenClaw ─────────────────────────────────────────────────────────────────
# OpenClaw 项目根目录（含 scripts/run-node.mjs 的目录）

# ── Local coding Provider ───────────────────────────────────────────────────
# Optional ACP v1 agents (Settings > Providers > ACP agents).
# Install the Host extra with: python -m pip install -e ".[acp]"
# Agent executables are installed separately. See docs/acp_provider.md.
# Each environment entry references a Host variable name, never a secret value.
AMADEUS_ACP_PROVIDERS=[]

# Official persistent Codex SDK/App Server transport (product default).
CODEX_APP_SERVER_PROVIDER_ENABLED=true
# Leave blank to use the runtime pinned by openai-codex.
# Amadeus owns these execution defaults; they do not inherit ~/.codex/config.toml.
# DeepSeek accepts max; the typed Codex SDK sends its compatible xhigh value.
# Optional Codex processing tier: fast uses more ChatGPT credits for lower latency.
CODEX_APP_SERVER_PROVIDER_API_KEY_ENV=DEEPSEEK_API_KEY
# Make Amadeus-created custom-provider threads resumable in Codex Desktop.
# Only provider metadata and a credential-helper command are written to the
# Codex user config; the API key remains in this .env file.
CODEX_APP_SERVER_SYNC_DESKTOP_PROVIDER=true
CODEX_APP_SERVER_PROVIDER_AUTH_ENV_FILE=
CODEX_APP_SERVER_APPROVAL_MODE=host
CODEX_APP_SERVER_TURN_TIMEOUT_S=7200
CODEX_APP_SERVER_APPROVAL_TIMEOUT_S=900
CODEX_APP_SERVER_CANCEL_CONFIRM_TIMEOUT_S=30

# Cooperative is the sole Chat runtime. COOPERATIVE_CHAT_ENABLED is retired:
# explicit false warns and is ignored. The old Off selected the original runtime;
# it never prohibited Work. Existing Work permission policy remains authoritative.
# Desktop explains stored values and deletes the retired key only on confirmation.
# Values in a launch environment or .env are read-only migration facts.
# Professional planner is on by default. False keeps basic cooperative routing.
# Uses the existing model transport and limits.
COOPERATIVE_WORK_PLANNER_ENABLED=true
# Optional model id supported by the selected LLM backend. Empty inherits its
# role model; this does not change Main Chat's model or execution Provider.
# Independent role assignments. GUI: Settings > Models > Roles > Work role assignments.
# Assigned roles automatically join cooperative routing using registered
# capabilities. Optional Host policy overrides and extra recipients only:
COOPERATIVE_CHAT_REQUIREMENTS_JSON={}
COOPERATIVE_CHAT_ADDITIONAL_REQUIREMENTS_JSON={}
COOPERATIVE_CHAT_QUERY_TIMEOUT_S=45
COOPERATIVE_CHAT_QUERY_MAX_TOKENS=900
# deny = automatic fail-closed; ask = the existing Chat permission card with an
# exact one-shot Allow once/Deny decision. Neither mode grants allow-always/trust.
COOPERATIVE_CHAT_PERMISSION_POLICY=ask

# Legacy turn-scoped ``codex exec`` transport. Do not enable together with
# CODEX_APP_SERVER_PROVIDER_ENABLED; both intentionally use Provider id codex.
DIRECT_CODEX_PROVIDER_ENABLED=false
# Use a directly executable Codex CLI. On Windows, do not rely on an
# inaccessible WindowsApps alias; point this at an installed codex.exe.
# Optional wrapper prefix, for example: -y @openai/codex when CLI_PATH=npx.cmd
DIRECT_CODEX_CLI_PREFIX_ARGS=
# Codex CLI 0.146.0 on native Windows can downgrade untrusted write workspaces
# to read-only when user config (including project trust) is ignored.
DIRECT_CODEX_IGNORE_USER_CONFIG=false
DIRECT_CODEX_PREFLIGHT_TIMEOUT_S=8
DIRECT_CODEX_TIMEOUT_S=7200
DIRECT_CODEX_EVENT_SILENCE_WARN_S=60
DIRECT_CODEX_STDERR_CAP_BYTES=12000

# Amadeus Project/Scratch/focus routing trust roots (semicolon-delimited).
WORK_PROJECT_ALLOWLIST=C:\path\to\project
# Optional override for redirected/managed Desktop folders. When omitted, Windows
# Known Folder resolution is used before falling back to %USERPROFILE%\Desktop.
AMADEUS_DESKTOP_PATH=
AMADEUS_PROVIDER_ACTIVITY_PATH=
WORK_AUTO_ACCEPT_APPROVED_EXPORTS=true
# P1: isolate new Project write tasks in a Host-owned Git worktree.
WORK_WORKTREE_ISOLATION=false
# WORK_WORKTREE_ROOT=C:\Users\user\AppData\Local\Amadeus\worktrees
WORK_WORKTREE_ENSURE_TIMEOUT_S=30
WORK_NARRATION_MIN_INTERVAL_S=20
WORK_NARRATION_DIAGNOSTIC_FIRST_N=5
WORK_NARRATION_DIAGNOSTIC_EVERY_N=25
WORK_TERMINAL_NARRATION_MAX_WAIT_S=20
# Persist bounded ASR/chat/TTS text previews in diagnostic logs. Keep disabled
# for ordinary use; logs still retain IDs, phases, sizes, and timings.
LOG_USER_CONTENT=false
# AUIP scene comments default on when a narration model is configured; deployments
# can still disable them explicitly while preserving AUIP state/action execution.
AUIP_NARRATION_ENABLED=true
AUIP_NARRATION_NORMAL_BEAT_STRIDE=3
# Alpha AppSession role branch: b2 is default; off/a1 are rollback modes. If
# its action model is not configured yet, the backend and Settings still start
# while application actions remain visibly blocked.
AUIP_APPSESSION_ROLE_BRANCH_MODE=b2
# B2 Hybrid keeps closed Host candidates and lets the same receipt-held role
# call fill only manifest-declared open payloads. off restores split fallback.
AUIP_B2_OPEN_PAYLOAD_MODE=candidate
# Empty provider/model inherit the configured AUIP/Main model. The validated
# high-value demo profile is openai + gpt-5.6-terra + low + fast.
AUIP_ACTION_TIMEOUT_S=8
AUIP_NARRATION_TIMEOUT_S=12

# Generation appearance preference; explicit user design and existing app styles win.
# Desktop Settings > Work Providers > Artifact appearance (restart backend to apply).

## Default Pi daily-task provider (native RPC, Node >=22.19).
## Desktop npm ci installs Pi automatically. Headless install or repair:
## npm ci --ignore-scripts --prefix agent_host/pi_runtime
## The default provider reuses DEEPSEEK_API_KEY above; startup checks that the
## selected Pi provider has credentials before advertising it as available.
PI_EXTENSIONS_JSON=[]
PI_TIMEOUT_S=1800
# Pi web search uses anonymous Exa MCP. No search API key or paid fallback.

