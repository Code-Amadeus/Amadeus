WAKE_ENABLED=false
# WAKE_PHRASES="Hey Amadeus,Hi Amadeus"
WAKE_AUTO_SEND_TO_CHAT=true
WAKE_ASR_BACKEND=sense_voice  # sense_voice | qwen3_asr
