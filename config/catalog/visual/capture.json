{
  "id": "vision",
  "title": {
    "en-US": "Multimodal & Vision",
    "zh-CN": "多模态与视觉"
  },
  "description": {
    "en-US": "General chat and desktop capture use these settings. VN vision is controlled separately in its game session.",
    "zh-CN": "这些设置用于通用聊天与桌面取图。VN 视觉在对应游戏会话中单独控制。"
  },
  "desktop": true,
  "apply": "host",
  "config": {
    "AMADEUS_VISION_ENABLED": {
      "type": "boolean",
      "title": {
        "en-US": "General vision (excluding VN)",
        "zh-CN": "通用视觉（不含 VN）"
      },
      "default": false,
      "description": {
        "en-US": "Controls vision outside VN. Each VN session has its own vision setting.",
        "zh-CN": "控制 VN 以外场景的视觉。每个 VN 会话使用自己的视觉设置。"
      },
      "scope": "session",
      "runtime_key": "vision_enabled",
      "true_values": [
        "1",
        "true",
        "yes",
        "on"
      ]
    },
    "AMADEUS_VISION_MODE": {
      "type": "enum",
      "title": {
        "en-US": "Vision Mode",
        "zh-CN": "视觉模式"
      },
      "default": "off",
      "description": {
        "en-US": "On-demand captures when asked; watching attaches one fresh frame to each chat turn",
        "zh-CN": "按需模式在请求时截图；持续观察模式为每轮对话附加新画面"
      },
      "scope": "session",
      "runtime_key": "vision_mode",
      "options": [
        "off",
        "on_demand",
        "watching",
        "self_aware"
      ],
      "icon": "Video"
    },
    "AMADEUS_VISION_SCOPE": {
      "type": "enum",
      "title": {
        "en-US": "Vision Scope",
        "zh-CN": "视觉范围"
      },
      "default": "full_screen",
      "description": {
        "en-US": "Choose what Amadeus may capture for a visual turn",
        "zh-CN": "选择 Amadeus 在视觉轮次中可以采集的范围"
      },
      "scope": "session",
      "runtime_key": "vision_scope",
      "options": [
        "full_screen",
        "current_window",
        "selected_window",
        {
          "value": "wallpaper_surface",
          "label": {
            "en-US": "wallpaper_surface",
            "zh-CN": "壁纸表面"
          },
          "hidden": true
        },
        {
          "value": "region",
          "label": {
            "en-US": "region",
            "zh-CN": "区域"
          },
          "hidden": true
        }
      ],
      "icon": "Video"
    },
    "AMADEUS_VISION_MAX_LONG_SIDE": {
      "type": "integer",
      "title": {
        "en-US": "Vision Image Size",
        "zh-CN": "视觉图像尺寸"
      },
      "default": 960,
      "description": {
        "en-US": "Maximum long edge sent to the model",
        "zh-CN": "发送给模型的最大长边尺寸"
      },
      "scope": "session",
      "runtime_key": "vision_max_long_side",
      "min": 320,
      "max": 4096,
      "step": 1,
      "control": "select",
      "options": [
        "640",
        "960",
        "1280",
        "1600"
      ],
      "icon": "Photo"
    },
    "AMADEUS_VISION_JPEG_QUALITY": {
      "type": "integer",
      "title": {
        "en-US": "Vision JPEG Quality",
        "zh-CN": "视觉 JPEG 质量"
      },
      "default": 68,
      "description": {
        "en-US": "Higher quality increases request payload size",
        "zh-CN": "更高质量会增加请求体积"
      },
      "scope": "session",
      "runtime_key": "vision_jpeg_quality",
      "min": 35,
      "max": 92,
      "step": 1,
      "control": "select",
      "options": [
        "50",
        "68",
        "80",
        "90"
      ],
      "icon": "Photo"
    },
    "AMADEUS_VISION_REGION": {
      "type": "string",
      "title": {
        "en-US": "Vision region",
        "zh-CN": "视觉区域"
      },
      "default": "",
      "scope": "session",
      "runtime_key": "vision_region"
    },
    "AMADEUS_VISION_WINDOW_HANDLE": {
      "type": "string",
      "title": {
        "en-US": "Vision target window",
        "zh-CN": "视觉目标窗口"
      },
      "default": "",
      "description": {
        "en-US": "Capture stops if this window closes or can no longer be verified.",
        "zh-CN": "如果窗口关闭或无法继续验证，采集会停止。"
      },
      "scope": "session",
      "runtime_key": "vision_window_handle"
    }
  }
}
