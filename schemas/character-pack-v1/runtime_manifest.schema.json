{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amadeus:character-pack-v1:runtime-manifest",
  "title": "Amadeus character-pack runtime manifest",
  "type": "object",
  "required": [
    "format",
    "id",
    "displayName",
    "version",
    "textureFormat",
    "graph",
    "mouthConfig",
    "clips",
    "mouthOverlays"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "amadeus.spriteforge.character-pack.v1"},
    "id": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "textureFormat": {"const": "ktx2"},
    "graph": {"$ref": "#/$defs/relativeJsonPath"},
    "mouthConfig": {"$ref": "#/$defs/relativeJsonPath"},
    "quality": {"type": "integer", "minimum": 0},
    "zcmp": {"type": "integer", "minimum": 0},
    "clips": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["phase", "frameIntervalMs", "loopMode", "frames"],
        "additionalProperties": false,
        "properties": {
          "phase": {"type": "string", "minLength": 1},
          "frameIntervalMs": {"type": "integer", "minimum": 1},
          "loopMode": {"enum": ["loop", "once_then_hold"]},
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/relativeKtx2Path"}
          }
        }
      }
    },
    "mouthOverlays": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/relativeKtx2Path"}
      }
    },
    "clipCount": {"type": "integer", "minimum": 1},
    "frameCount": {"type": "integer", "minimum": 1},
    "textureCount": {"type": "integer", "minimum": 1},
    "textureBytes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "relativeJsonPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
    },
    "relativeKtx2Path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ktx2$"
    }
  }
}
