{
  "schema": "amadeus.source-release-policy.v1",
  "distribution_model": "source-available-noncommercial",
  "first_party_license": {
    "status": "selected",
    "identifier": "PolyForm-Noncommercial-1.0.0",
    "license_file": "LICENSE",
    "scope": "Amadeus first-party code, documentation, modifications, and recorded original brand assets; third-party paths retain their recorded licenses"
  },
  "archive_prefix": "amadeus-{version}",
  "required_files": [
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSES/AP-BWE-MIT.txt",
    "local_tts_infer.py",
    "LICENSES/FIRST-PARTY-BRAND-ASSETS.md",
    "LICENSES/Live2D-Cubism-Core-NOTICE.md",
    "LICENSES/Apache-2.0.txt",
    "LICENSES/Bert-VITS2-Cantonese-Yue-AGPL-3.0.txt",
    "LICENSES/CMUdict-BSD-2-Clause.txt",
    "LICENSES/README.md",
    "LICENSES/GPT-SoVITS-MIT.txt",
    "LICENSES/GPT-SoVITS-NESTED-NOTICES.md",
    "LICENSES/GPT-SoVITS-UPSTREAM-RELIANCE.md",
    "LICENSES/PyTorch-BSD-3-Clause.txt",
    "LICENSES/provenance.json",
    "emotion_presets.json",
    "docs/auip_application_sessions.md",
    "docs/capability_catalog_v0.md",
    "docs/character_pack_authoring.md",
    "docs/external_asset_bundles.md",
    "docs/wake_word_setup.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README_EN.md",
    "ROADMAP.md",
    "main.py",
    "requirements-cu124.txt",
    "requirements-dev.txt",
    "requirements.txt",
    "requirements/locks/README.md",
    "requirements/locks/windows-py312-ci.txt",
    "requirements/locks/windows-py312-cpu.txt",
    "requirements/locks/windows-py312-cu124-observed.txt",
    "run_electron_cu124.bat",
    "run_electron_utf8.bat",
    "SECURITY.md",
    "SUPPORT.md",
    "pyproject.toml"
  ],
  "include_roots": [
    ".github",
    "LICENSES",
    "agent_host",
    "architecture",
    "asr",
    "assets",
    "config",
    "core",
    "electron",
    "examples",
    "GPT_SoVITS",
    "llm",
    "openclaw",
    "release",
    "render",
    "requirements",
    "sdk",
    "schemas",
    "server",
    "skills",
    "tests",
    "tools",
    "tts",
    "vn_player",
    "vts",
    "wallpaper"
  ],
  "include_files": [
    ".env.example",
    ".gitignore",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "docs/asr_speculative_endpointing.md",
    "docs/auip_application_sessions.md",
    "docs/barge_in_aec_interrupt_notes.md",
    "docs/browser_interaction_branch_lifecycle.md",
    "docs/capability_catalog_v0.md",
    "docs/character_pack_authoring.md",
    "docs/external_asset_bundles.md",
    "docs/local_instance_authentication.md",
    "docs/mouth_sync_system_notes.md",
    "docs/render_vendor_compatibility.md",
    "docs/wake_word_setup.md",
    "emotion_presets.json",
    "LICENSE",
    "local_tts_infer.py",
    "README.md",
    "README_EN.md",
    "ROADMAP.md",
    "main.py",
    "run_electron_utf8.bat",
    "run_electron_cu124.bat",
    "start_hybrid_llm.bat",
    "start_llm_server.bat",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    "pyproject.toml",
    "requirements-cu124.txt",
    "requirements.txt",
    "requirements-dev.txt"
  ],
  "exclude_globs": [
    ".github/ISSUE_TEMPLATE/config.yml",
    "docs/reports/**",
    "docs/cn/README.md",
    "docs/ja/README.md",
    "docs/ko/README.md",
    "docs/tr/README.md",
    "legacy/**",
    "GPT_SoVITS/text/cantonese.py",
    "GPT_SoVITS/text/ja_userdic/**",
    "GPT_SoVITS/text/**/*.pickle",
    "tools/AP_BWE_main/**",
    "tools/audio_sr.py",
    "tools/uvr5/**",
    "render/web/vendor/live2dcubismcore.min.js",
    "assets/models/live2d/**",
    "assets/models/gsvlite/**",
    "assets/models/gpt-sovits/**",
    "assets/models/asr/**",
    "assets/models/source-separation/**",
    "assets/previews/**",
    "assets/demo/**",
    "assets/architecture-overview-crt.svg",
    "assets/header-strip.en.svg",
    "assets/header-strip.zh.svg",
    "assets/star-history.svg",
    "assets/scenarios/**",
    "assets/source/**",
    "assets/spriteforge/**"
  ],
  "deny_globs": [
    ".env",
    ".env.*",
    "**/*.key",
    "**/*.pem",
    "**/*.p12",
    "**/*.pfx",
    "**/*.keystore",
    "**/*.ckpt",
    "**/*.pth",
    "**/*.gguf",
    "**/*.bin",
    "**/*.pyd",
    "**/*.so",
    "**/vts_auth_token.json",
    "sessions/**",
    "runtime/**",
    "logs/**",
    ".amadeus/**"
  ],
  "deny_allow_globs": [
    ".env.example"
  ],
  "content_rules": [
    {
      "id": "private-windows-user-path",
      "severity": "error",
      "pattern": "(?i)[A-Z]:\\\\Users\\\\(?!<|your-|username|user\\b)[^\\\\\r\n]+\\\\"
    },
    {
      "id": "private-unix-home-path",
      "severity": "error",
      "pattern": "(?m)(?<![A-Za-z0-9_])/(?:home|Users)/(?!<|your-|username|user/)[^/\\s]+/"
    },
    {
      "id": "private-notion-url",
      "severity": "warning",
      "pattern": "https?://(?:www\\.)?notion\\.(?:so|site)/[^\\s)>]+"
    },
    {
      "id": "high-confidence-secret-assignment",
      "severity": "error",
      "pattern": "(?i)(?:api[_-]?key|secret|access[_-]?token|bearer[_-]?token)\\s*[:=]\\s*['\"](?!<|your-|example|dummy|test|\\{|\\$\\{|os\\.|env\\.)[^'\"\\s]{12,}['\"]"
    }
  ],
  "content_scan_extensions": [
    ".bat",
    ".c",
    ".cc",
    ".cfg",
    ".cmd",
    ".cpp",
    ".css",
    ".cu",
    ".env",
    ".h",
    ".html",
    ".ini",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".ps1",
    ".py",
    ".sh",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".yaml",
    ".yml"
  ],
  "max_file_bytes": 5242880,
  "large_file_allow_globs": [],
  "provenance_manifest": "LICENSES/provenance.json"
}
