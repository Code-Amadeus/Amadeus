{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "amadeus.catalog/v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "generator_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "host_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "display": {
            "type": "object",
            "maxProperties": 16
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "host_api": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "python": {
                "type": "string",
                "maxLength": 256
              },
              "platforms": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "sdk": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "dependencies": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "contributions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "role": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "contract": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "kind",
                    "role",
                    "contract"
                  ],
                  "additionalProperties": false
                }
              },
              "delivery": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "runtime": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "host_api",
              "python",
              "platforms",
              "sdk",
              "dependencies",
              "contributions",
              "delivery",
              "runtime"
            ],
            "additionalProperties": false
          },
          "publisher": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maintainers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "package_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "maintainers",
              "package_ids",
              "evidence"
            ],
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "policy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "sha256",
              "policy",
              "reviewer",
              "date",
              "evidence"
            ],
            "additionalProperties": false
          },
          "withdrawal": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "enum": [
                      "maintainer",
                      "copyright"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "reason",
                  "evidence"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "url",
          "size",
          "display",
          "compatibility",
          "publisher",
          "review",
          "withdrawal"
        ],
        "additionalProperties": false
      }
    },
    "security": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "blocked",
              "allowed"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "enum": [
              "security",
              "security-resolved"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "status",
          "sequence",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "sequence",
    "source_commit",
    "source_time",
    "generator_commit",
    "host_commit",
    "entries",
    "security"
  ],
  "additionalProperties": false
}
